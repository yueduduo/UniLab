<mujoco model="k1 vel cmd compat">
  <include file="k1.xml"/>

  <!-- Same robot stand keyframe / COL_Collider ground as scene_soccer_dribble_minimal (no ball). -->
  <option density="1.2" viscosity="0.00002" timestep="0.002"/>

  <statistic center="0 0 0.5743699226900935" extent="3.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.15 0.15 0.15" specular="0.3 0.3 0.3"/>
    <global azimuth="120" elevation="-18"/>
  </visual>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" directional="true"/>
    <geom name="pitch" pos="0 0 0" size="180 135 1" type="plane" contype="0" conaffinity="0" rgba="0.18 0.45 0.18 1"/>
    <geom
      name="COL_Collider"
      pos="0 0 -0.1"
      type="box"
      size="180 135 0.1"
      friction="1.0 0.005 0.02"
      group="3"
    />
  </worldbody>

  <sensor>
    <contact name="left_foot_contact_0" geom1="COL_Collider" geom2="left_foot_contact_0_geom" data="found" num="1" reduce="mindist"/>
    <contact name="left_foot_contact_1" geom1="COL_Collider" geom2="left_foot_contact_1_geom" data="found" num="1" reduce="mindist"/>
    <contact name="left_foot_contact_2" geom1="COL_Collider" geom2="left_foot_contact_2_geom" data="found" num="1" reduce="mindist"/>
    <contact name="left_foot_contact_3" geom1="COL_Collider" geom2="left_foot_contact_3_geom" data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_0" geom1="COL_Collider" geom2="right_foot_contact_0_geom" data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_1" geom1="COL_Collider" geom2="right_foot_contact_1_geom" data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_2" geom1="COL_Collider" geom2="right_foot_contact_2_geom" data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_3" geom1="COL_Collider" geom2="right_foot_contact_3_geom" data="found" num="1" reduce="mindist"/>
  </sensor>

  <keyframe>
    <key
      name="stand"
      qpos="
      0 0 0.5743699226900935
      1 0 0 0
      0 0
      0 -1.3 0 -0.5
      0 1.3 0 0.5
      -0.15 0 0 0.3 -0.15 0
      -0.15 0 0 0.3 -0.15 0
      "
      ctrl="
      0 0
      0 -1.3 0 -0.5
      0 1.3 0 0.5
      -0.15 0 0 0.3 -0.15 0
      -0.15 0 0 0.3 -0.15 0
      "
    />
  </keyframe>
</mujoco>
