<mujoco model="k1 soccer dribble minimal">
  <include file="k1.xml"/>

  <!--
    贴合 sim_soccer2 (assets/environments/soccer/world.xml):
      - 地面碰撞用 box COL_Collider（非 plane），球用 mesh 碰撞 + 硬接触 default solref（不 override）。
      - mesh 球在 Motrix 下才有滚动减速；sphere 几乎无阻力。
    针对 Motrix + 本场景 qpos 的几何适配（见 zzz_debug/BALL_PHYSICS.md）:
      - box 顶面对齐 z=0（pos z=-0.1, half=0.1），避免球/脚初始嵌入 box 导致 solver NotPositiveDefinite panic。
      - 加厚 box 同时提升接触稳定性并防止高速球穿透。
      - timestep=0.002：Motrix 的 impulse solver 在 0.005 下 box+mesh 会发散，0.002 极稳
        （sim_soccer2 用 MuJoCo Newton+impratio=10+timestep=0.001，Motrix 求解器不同）。
  -->
  <option density="1.2" viscosity="0.00002" timestep="0.002"/>

  <asset>
    <texture type="2d" name="soccer_ball_tex" file="soccer_ball/Robot_Football.png"/>
    <material name="soccer_ball_mat" texture="soccer_ball_tex" rgba="1 1 1 1"/>
    <mesh name="soccer_ball_mesh" file="soccer_ball/Robot_Football.obj"/>
  </asset>

  <statistic center="1.1 0 0.5743699226900935" extent="3.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.15 0.15 0.15" specular="0.3 0.3 0.3"/>
    <global azimuth="120" elevation="-18"/>
  </visual>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" directional="true"/>
    <geom name="pitch" pos="0 0 0" size="180 135 1" type="plane" contype="0" conaffinity="0" rgba="0.18 0.45 0.18 1"/>
    <geom
      name="COL_Collider"
      pos="0 0 -0.1"
      type="box"
      size="180 135 0.1"
      friction="1.0 0.005 0.02"
      group="3"
    />

    <!-- 一阶段终点：小半透明球（contype/conaffinity=0、mass=0，无碰撞；穿过球体即完成） -->
    <geom
      name="phase1_waypoint_marker_pending"
      type="sphere"
      pos="1.0 0 0.5743699226900935"
      size="0.08"
      rgba="0.25 0.95 0.3 0.12"
      contype="0"
      conaffinity="0"
      mass="0"
      density="0"
      group="1"
    />
    <geom
      name="phase1_waypoint_marker_reached"
      type="sphere"
      pos="1.0 0 -30"
      size="0.08"
      rgba="0.95 0.2 0.2 0.12"
      contype="0"
      conaffinity="0"
      mass="0"
      density="0"
      group="1"
    />

    <body name="ball" pos="1.2 0 0.09167862683534622">
      <joint name="ball-root" type="free"/>
      <geom
        name="ball_visual"
        type="mesh"
        mesh="soccer_ball_mesh"
        material="soccer_ball_mat"
        contype="0"
        conaffinity="0"
        group="1"
        mass="0"
      />
      <geom
        name="ball_geom"
        type="mesh"
        mesh="soccer_ball_mesh"
        mass="0.43"
        friction="1.0 0.02 0.05"
        group="3"
      />
    </body>
  </worldbody>

  <sensor>
    <contact name="left_foot_contact_0" geom1="COL_Collider" geom2="left_foot_contact_0_geom" data="found" num="1" reduce="mindist"/>
    <contact name="left_foot_contact_1" geom1="COL_Collider" geom2="left_foot_contact_1_geom" data="found" num="1" reduce="mindist"/>
    <contact name="left_foot_contact_2" geom1="COL_Collider" geom2="left_foot_contact_2_geom" data="found" num="1" reduce="mindist"/>
    <contact name="left_foot_contact_3" geom1="COL_Collider" geom2="left_foot_contact_3_geom" data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_0" geom1="COL_Collider" geom2="right_foot_contact_0_geom" data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_1" geom1="COL_Collider" geom2="right_foot_contact_1_geom" data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_2" geom1="COL_Collider" geom2="right_foot_contact_2_geom" data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_3" geom1="COL_Collider" geom2="right_foot_contact_3_geom" data="found" num="1" reduce="mindist"/>
  </sensor>

  <keyframe>
    <key
      name="stand"
      qpos="
      0 0 0.5743699226900935
      1 0 0 0
      0 0
      0 -1.3 0 -0.5
      0 1.3 0 0.5
      -0.15 0 0 0.3 -0.15 0
      -0.15 0 0 0.3 -0.15 0
      1.2 0 0.09167862683534622 1 0 0 0
      "
      ctrl="
      0 0
      0 -1.3 0 -0.5
      0 1.3 0 0.5
      -0.15 0 0 0.3 -0.15 0
      -0.15 0 0 0.3 -0.15 0
      "
    />
  </keyframe>
</mujoco>
